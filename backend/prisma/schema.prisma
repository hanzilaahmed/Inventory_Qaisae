generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  name      String   @default("Admin")
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String      @id @default(uuid())
  name            String
  sku             String      @unique
  category        String?
  description     String?
  // Selling unit configuration: "PIECE_ONLY", "BOX_ONLY", "BOTH"
  sellingUnitType String      @default("BOTH")
  // How many individual pieces make up 1 box (default 1)
  piecesPerBox    Int         @default(1)
  // Selling price per single piece
  pricePerPiece   Float       @default(0.0)
  // Selling price per box
  pricePerBox     Float       @default(0.0)
  // Cost price (purchase price)
  costPrice       Float       @default(0.0)
  // Master inventory count tracked in single PIECES
  stockPieces     Int         @default(0)
  // Low stock threshold (in pieces)
  minStockAlert   Int         @default(10)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  stockLogs       StockLog[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String      @default("Walk-in Customer")
  customerPhone String?
  subtotal      Float       @default(0.0)
  discount      Float       @default(0.0)
  tax           Float       @default(0.0)
  totalAmount   Float       @default(0.0)
  paymentMethod String      @default("CASH") // "CASH", "CARD", "ONLINE", "CREDIT"
  status        String      @default("COMPLETED") // "COMPLETED", "CANCELLED"
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  stockLogs     StockLog[]
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  unitSold       String   // "PIECE" or "BOX"
  quantity       Int      // Quantity of units sold (e.g. 2 boxes or 3 pieces)
  piecesPerBox   Int      @default(1) // Snapshot of box size
  piecesDeducted Int      // Total pieces deducted (quantity if PIECE, quantity * piecesPerBox if BOX)
  unitPrice      Float    // Price charged per piece or box
  totalPrice     Float    // quantity * unitPrice
  createdAt      DateTime @default(now())
}

model StockLog {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type            String   // "SALE", "RESTOCK", "INITIAL", "ADJUSTMENT"
  quantityChanged Int      // positive (restock/initial) or negative (sale)
  stockBefore     Int
  stockAfter      Int
  notes           String?
  createdAt       DateTime @default(now())
}
